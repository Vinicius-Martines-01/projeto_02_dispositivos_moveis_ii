<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Título -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JOKENPO"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Modo Melhor de 3 -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchMelhorDe3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modo Melhor de 3 "
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Placar -->
    <LinearLayout
        android:id="@+id/layoutPlacar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/switchMelhorDe3">

        <TextView
            android:id="@+id/txtPlacarUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuário: 0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginEnd="20dp"/>

        <TextView
            android:id="@+id/txtPlacarPC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PC: 0"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Escolha do Computador -->
    <TextView
        android:id="@+id/labelPC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha do Computador:"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/layoutPlacar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <ImageView
        android:id="@+id/imgPadrao"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:contentDescription="Escolha do computador"
        app:layout_constraintTop_toBottomOf="@id/labelPC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        app:srcCompat="@drawable/padrao" />

    <!-- Resultado da rodada -->
    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha uma opção"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/design_default_color_primary"
        app:layout_constraintTop_toBottomOf="@id/imgPadrao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Opções do Usuário -->
    <LinearLayout
        android:id="@+id/layoutOpcoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/txtResultado"
        android:layout_marginTop="20dp">

        <ImageView
            android:id="@+id/imgPedra"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Pedra"
            app:srcCompat="@drawable/pedra" />

        <ImageView
            android:id="@+id/imgPapel"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Papel"
            app:srcCompat="@drawable/papel" />

        <ImageView
            android:id="@+id/imgTesoura"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Tesoura"
            app:srcCompat="@drawable/tesoura" />
    </LinearLayout>

    <!-- Botão Limpar -->
    <Button
        android:id="@+id/btnLimpar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LIMPAR"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
